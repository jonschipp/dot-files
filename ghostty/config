# Send Cmd chords through to tmux as private escape sequences; tmux binds them
# via user-keys (see tmux/tmux.conf, which must stay in sync with this list).
keybind = super+d=text:"\x1b[3000~"
keybind = super+shift+d=text:"\x1b[3001~"
keybind = super+left_bracket=text:"\x1b[3002~"
keybind = super+right_bracket=text:"\x1b[3003~"
keybind = super+shift+enter=text:"\x1b[3004~"
keybind = super+t=text:"\x1b[3005~"
keybind = super+left=text:"\x1b[3006~"
keybind = super+right=text:"\x1b[3007~"
keybind = super+up=text:"\x1b[3008~"
keybind = super+down=text:"\x1b[3009~"

# Colors
theme = iTerm2 Solarized Dark
